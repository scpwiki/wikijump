    "@types/accept-language-parser": "^1.5.8",
    "@types/node": "^26.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "postcss": "^8.5.25",
    "postcss-html": "^1.8.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.9.6",
