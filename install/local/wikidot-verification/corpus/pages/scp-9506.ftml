[[module CSS]]
.nfsi-grid { display: grid; grid-template-columns: repeat(4, minmax(80px, 1fr)); gap: 8px; margin: 1rem 0; }
.nfsi-grid img { width: 100%; border: 1px solid #777; background: #f8f8f8; }
.nfsi-alert { border-left: 6px solid #8a2d2d; padding: 0.8rem 1rem; background: #fff6da; }
[[/module]]

