{
  "name": "wikidot-verification",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.10.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "test": "../../../scripts/run-test-no-external-network.sh node --test tests/*.test.mjs",
    "test:ci": "../../../scripts/run-test-no-external-network.sh node --test tests/*.test.mjs",
    "offline": "pnpm run test:ci && pnpm run offline:syntax",
    "offline:syntax": "../../../scripts/run-offline-syntax-compatibility.sh",
    "offline:products": "../../../scripts/run-offline-product-compatibility.sh",
    "offline:portable": "pnpm run offline && pnpm run offline:products",
    "offline:browser": "../../../scripts/run-offline-standing-browser-test.sh node scripts/run-offline-browser-oracle.mjs",
    "offline:all": "pnpm run offline:portable && pnpm run offline:browser",
    "generated-contracts:verify": "node scripts/verify-repository-generated-contracts.mjs --full",
    "generated-contracts:verify:repository": "node scripts/verify-repository-generated-contracts.mjs",
    "completion": "node scripts/run-completion-controller.mjs",
    "compatibility-inventory": "node scripts/build-compatibility-surface-inventory.mjs",
    "compatibility-ledger": "node scripts/build-compatibility-ledger.mjs",
    "compatibility-final-denominators": "node scripts/build-compatibility-final-denominators.mjs",
    "syntax-dispositions": "node scripts/check-syntax-differential-dispositions.mjs",
    "corpus-pinned-literals": "node scripts/check-corpus-pinned-literals.mjs",
    "wikijump-identifier-leaks": "node scripts/check-wikijump-identifier-leaks.mjs",
    "sandbox-oracle": "node scripts/compare-sandbox-oracle.mjs",
    "sandbox-oracle-capture": "node scripts/capture-sandbox-oracle.mjs",
    "reference-inventory": "node scripts/build-reference-acquisition-inventory.mjs",
    "listpages-campaign-inventory": "node scripts/build-listpages-campaign-inventory.mjs",
    "listpages-runtime-budget-envelope": "node scripts/build-listpages-runtime-budget-envelope.mjs",
    "listpages-campaign-matrix": "node scripts/build-listpages-campaign-matrix.mjs",
    "listpages-preview-cases": "node scripts/export-listpages-preview-cases.mjs",
    "listpages-preview-differential": "node scripts/run-listpages-preview-differential.mjs",
    "listpages-preview-classification": "node scripts/classify-listpages-preview-differential.mjs",
    "listpages-corpus-replay-reconciliation": "node scripts/reconcile-listpages-corpus-replay.mjs",
    "listpages-live-fixture-plan": "node scripts/build-listpages-live-fixture-plan.mjs",
    "listpages-live-fixture-classification": "node scripts/classify-listpages-live-fixtures.mjs",
    "listpages-feed-endpoint": "node scripts/capture-listpages-feed-endpoint.mjs",
    "runtime-differential": "node scripts/run-generic-runtime-differential.mjs",
    "runtime-differential-stack": "node scripts/run-generic-runtime-differential-stack.mjs",
    "identity-bound-differential": "node scripts/run-identity-bound-differential.mjs",
    "firefox-evidence-replay": "node scripts/replay-firefox-evidence.mjs",
    "candidate-cases": "node scripts/run-candidate-cases.mjs",
    "candidate-campaign": "node scripts/run-candidate-campaign.mjs",
    "candidate-campaign-aggregate": "node scripts/aggregate-candidate-case-campaign.mjs",
    "candidate-account-provision": "node scripts/provision-candidate-account.mjs"
  },
  "dependencies": {
    "devalue": "5.9.3",
    "parse5": "^8.0.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0"
  }
}
