{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikijump.org/schemas/reference-acquisition-attempt-v1.schema.json",
  "title": "Wikidot reference acquisition attempt",
  "description": "Normative framing: one UTF-8 JSON value followed by one LF, with no CR or other lines, at most 1048576 bytes. stable-json-v1 follows ECMAScript JSON.stringify primitive serialization, emits non-ASCII code points as literal UTF-8, uses required JSON escapes for controls, quotation mark, and reverse solidus, applies no Unicode normalization, recursively emits object keys in Unicode code-point order with no insignificant whitespace, and preserves array order. work_identity.sha256 is SHA-256 of stable-json-v1 over the exact object {inventory,layer,producer}. Object bindings have unique roles and are strictly ascending by role.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "attempt_id",
    "inventory",
    "producer",
    "layer",
    "work_identity",
    "started_at",
    "finished_at",
    "outcome",
    "objects",
    "failure"
  ],
  "properties": {
    "schema": {
      "const": "wikijump_full_parity.reference_acquisition_attempt.v1"
    },
    "attempt_id": { "$ref": "#/$defs/uuid" },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "fixture_id", "ordinal", "semantic_row_sha256"],
      "properties": {
        "sha256": { "$ref": "#/$defs/sha256" },
        "fixture_id": { "type": "string", "minLength": 3 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "semantic_row_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "identity"],
      "properties": {
        "contract": { "$ref": "#/$defs/identifier" },
        "identity": {
          "$ref": "https://wikijump.org/schemas/reference-object-v1.schema.json"
        }
      }
    },
    "layer": {
      "enum": ["xmlrpc_page", "http_document", "browser_document"]
    },
    "work_identity": { "$ref": "#/$defs/identity" },
    "started_at": { "$ref": "#/$defs/timestamp" },
    "finished_at": { "$ref": "#/$defs/timestamp" },
    "outcome": { "enum": ["complete", "failed"] },
    "objects": {
      "type": "array",
      "description": "Bindings must be unique by role and strictly ascending by Unicode code point role; runtime validation enforces this canonical order.",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "media_type", "object"],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "media_type": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,63}/[a-z0-9][a-z0-9!#$&^_.+-]{0,63}$"
          },
          "object": {
            "$ref": "https://wikijump.org/schemas/reference-object-v1.schema.json"
          }
        }
      }
    },
    "failure": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "retryable"],
          "properties": {
            "code": { "$ref": "#/$defs/identifier" },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "complete" } } },
      "then": {
        "properties": {
          "failure": { "type": "null" },
          "objects": { "minItems": 1 }
        }
      },
      "else": {
        "properties": { "failure": { "type": "object" } }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "stable-json-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
