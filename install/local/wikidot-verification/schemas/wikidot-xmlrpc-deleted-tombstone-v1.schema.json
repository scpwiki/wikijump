{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikijump.org/schemas/wikidot-xmlrpc-deleted-tombstone-v1.schema.json",
  "title": "Wikidot XML-RPC deleted-page tombstone v1",
  "description": "A terminal read-only observation that the pinned XML-RPC worker classified an exact frozen-inventory target as deleted. It is not an empty page, a live response, a permission result, or a compatibility verdict. It contains no raw fault text or credentials.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline",
    "capture",
    "classification",
    "endpoint",
    "fallback_used",
    "fullname",
    "inventory",
    "method",
    "raw_wire_captured",
    "read_only",
    "schema",
    "site",
    "source_entity_id",
    "source_url",
    "work_identity"
  ],
  "properties": {
    "baseline": { "$ref": "#/$defs/baseline" },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finished_at", "started_at"],
      "properties": {
        "finished_at": { "$ref": "#/$defs/captureTimestamp" },
        "started_at": { "$ref": "#/$defs/captureTimestamp" }
      }
    },
    "classification": { "const": "wikidot_deleted" },
    "endpoint": { "const": "https://www.wikidot.com/xml-rpc-api.php" },
    "fallback_used": { "const": false },
    "fullname": { "type": "string", "minLength": 1 },
    "inventory": { "$ref": "#/$defs/inventoryBinding" },
    "method": { "const": "pages.get_one" },
    "raw_wire_captured": { "const": false },
    "read_only": { "const": true },
    "schema": {
      "const": "wikijump_full_parity.wikidot_xmlrpc_deleted_tombstone.v1"
    },
    "site": { "const": "scp-wiki" },
    "source_entity_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source_url": {
      "type": "string",
      "pattern": "^https://scp-wiki\\.wikidot\\.com/"
    },
    "work_identity": { "$ref": "#/$defs/identity" }
  },
  "$defs": {
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meta_sha256", "revisions", "source_sha256", "updated_at"],
      "properties": {
        "meta_sha256": { "$ref": "#/$defs/sha256" },
        "revisions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "captureTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "canonicalization", "sha256"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "canonicalization": { "const": "stable-json-v1" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "inventoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_id", "ordinal", "semantic_row_sha256", "sha256"],
      "properties": {
        "fixture_id": { "type": "string", "minLength": 1 },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "semantic_row_sha256": { "$ref": "#/$defs/sha256" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
