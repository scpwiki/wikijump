{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikijump.org/schemas/wikidot-xmlrpc-implementation-v1.schema.json",
  "title": "Wikidot XML-RPC acquisition implementation v1",
  "description": "Canonical implementation authority stored as a content-addressed object. File hashes are SHA-256 digests of raw bytes at exact repository-relative paths; dependency_lock_path is relative to worker_repository. Credential values and derived hashes, timestamps, process identities, host paths, and compatibility verdicts are forbidden.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coordinator_file_sha256",
    "coordinator_path",
    "coordinator_repository",
    "dependency_lock_file_sha256",
    "dependency_lock_path",
    "endpoint",
    "fallback_used",
    "method",
    "node_version",
    "python_version",
    "rate_capacity",
    "rate_refill_per_second",
    "read_only",
    "retry_max_attempts",
    "retry_max_delay_seconds",
    "retry_wait_max_seconds",
    "schema",
    "site",
    "wikijump_commit",
    "wikijump_tree",
    "worker_file_sha256",
    "worker_path",
    "worker_repository",
    "worker_repository_commit",
    "worker_repository_tree"
  ],
  "properties": {
    "coordinator_file_sha256": { "$ref": "#/$defs/sha256" },
    "coordinator_path": {
      "const": "install/local/wikidot-verification/src/wikidot-xmlrpc-acquisition-runner.mjs"
    },
    "coordinator_repository": { "const": "Rokurolize/wikijump" },
    "dependency_lock_file_sha256": { "$ref": "#/$defs/sha256" },
    "dependency_lock_path": { "const": "uv.lock" },
    "endpoint": { "const": "https://www.wikidot.com/xml-rpc-api.php" },
    "fallback_used": { "const": false },
    "method": { "const": "pages.get_one" },
    "node_version": {
      "type": "string",
      "pattern": "^v(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "python_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
    },
    "rate_capacity": { "const": 1 },
    "rate_refill_per_second": { "const": 0.25 },
    "read_only": { "const": true },
    "retry_max_attempts": { "const": 5 },
    "retry_max_delay_seconds": { "const": 120 },
    "retry_wait_max_seconds": { "const": 60 },
    "schema": {
      "const": "wikijump_full_parity.wikidot_xmlrpc_implementation.v1"
    },
    "site": { "const": "scp-wiki" },
    "wikijump_commit": { "$ref": "#/$defs/gitSha1" },
    "wikijump_tree": { "$ref": "#/$defs/gitSha1" },
    "worker_file_sha256": { "$ref": "#/$defs/sha256" },
    "worker_path": { "const": "scripts/wikidot_xmlrpc_capture_worker.py" },
    "worker_repository": { "const": "Rokurolize/scp-wiki-translation" },
    "worker_repository_commit": { "$ref": "#/$defs/gitSha1" },
    "worker_repository_tree": { "$ref": "#/$defs/gitSha1" }
  },
  "$defs": {
    "gitSha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
